---
import { contact } from "../data/site";

const links = [
  { label: "Email", value: contact.email, href: `mailto:${contact.email}` },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/deionwellsross",
    href: contact.linkedin,
  },
  { label: "GitHub", value: "github.com/deion-wells-ross", href: contact.github },
];
---

<section id="contact" class="bg-cream">
  <div class="mx-auto max-w-5xl px-6" style="padding-block: var(--space-section)">
    <p class="eyebrow text-espresso reveal">Contact</p>
    <h2 class="reveal mt-4 text-forest" style="font-size: var(--text-h2)">
      Contact
    </h2>
    <p class="reveal mt-4 max-w-2xl text-ink/70">
      If you're working on something where AI could change how the work gets
      done, I'd like to hear about it.
    </p>

    <div class="mt-12 border-t border-espresso/20 pt-10">
      <ul class="reveal space-y-6">
        {
          links.map((link) => (
            <li>
              <span class="eyebrow block text-espresso/70">{link.label}</span>
              <a
                href={link.href}
                class="link mt-1 inline-block text-lg"
                {...link.label !== "Email"
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {}}
              >
                {link.value}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
