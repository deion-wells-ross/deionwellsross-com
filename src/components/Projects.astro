---
import { projects } from "../data/site";
---

<section id="projects" class="on-dark bg-forest text-cream">
  <div class="mx-auto max-w-5xl px-6" style="padding-block: var(--space-section)">
    <p class="eyebrow text-cream/55 reveal">Selected work</p>
    <h2 class="reveal mt-4 text-cream" style="font-size: var(--text-h2)">
      Selected Projects
    </h2>
    <p class="reveal mt-4 max-w-2xl text-cream/70">
      A few representative engagements — the problem, what was built, and the
      outcome for the business.
    </p>

    <div class="mt-16 flex flex-col">
      {
        projects.map((project, i) => (
          <article class="reveal grid gap-6 border-t border-cream/15 py-12 first:border-t-0 md:grid-cols-[1fr_2fr] md:gap-10">
            <div>
              <p class="numeral text-3xl">{String(i + 1).padStart(2, "0")}</p>
              <h3
                class="mt-2 text-cream"
                style="font-size: var(--text-h3)"
              >
                {project.title}
              </h3>
              <ul class="mt-5 flex flex-wrap gap-2">
                {project.technology.map((tech) => (
                  <li class="border border-cream/25 px-2.5 py-1 text-xs tracking-wide text-cream/70">
                    {tech}
                  </li>
                ))}
              </ul>
              {project.links && project.links.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-2">
                  {project.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-block border border-cream/25 px-2.5 py-1 text-xs tracking-wide text-cream/70 transition-colors hover:border-cream/60 hover:text-cream"
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <dl class="space-y-5">
              {[
                ["Problem", project.problem],
                ["Solution", project.solution],
                ["My contribution", project.contribution],
                ["Business outcome", project.outcome],
              ].map(([label, body]) => (
                <div>
                  <dt class="eyebrow text-cream/50">{label}</dt>
                  <dd class="mt-1.5 text-cream/85">{body}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))
      }
    </div>
  </div>
</section>
